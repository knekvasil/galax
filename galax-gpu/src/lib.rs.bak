use std::borrow::Cow;
use std::mem;
use std::sync::Arc;

use galax_core::{BodiesSoA, InteractionLists, Tree};

#[repr(C)]
#[derive(Copy, Clone)]
struct SimParamsRaw {
    n: u32,
    num_nodes: u32,
    num_leaves: u32,
    p: u32,
    eps: f32,
    _pad: f32,
}

const UNIFORM_PADDED_SIZE: u64 = 256;

pub struct GpuConfig {
    pub max_n: u32,
    pub max_nodes: u32,
    pub max_interactions: u32,
    pub p: u32,
    pub eps: f32,
}

impl Default for GpuConfig {
    fn default() -> Self {
        Self {
            max_n: 262_144,
            max_nodes: 524_288,
            max_interactions: 1 << 24,
            p: 4,
            eps: 0.1,
        }
    }
}

#[derive(Debug)]
pub enum GpuError {
    InitFailed(String),
    ShaderCompilation(String),
    BufferAllocation(String),
}

impl std::fmt::Display for GpuError {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        match self {
            GpuError::InitFailed(msg) => write!(f, "GPU init failed: {}", msg),
            GpuError::ShaderCompilation(msg) => write!(f, "shader compilation: {}", msg),
            GpuError::BufferAllocation(msg) => write!(f, "buffer allocation: {}", msg),
        }
    }
}

impl std::error::Error for GpuError {}

fn bytes_of<T>(val: &T) -> &[u8] {
    let size = mem::size_of::<T>();
    unsafe { std::slice::from_raw_parts(val as *const T as *const u8, size) }
}

fn bytes_of_slice<T>(val: &[T]) -> &[u8] {
    let size = val.len().checked_mul(mem::size_of::<T>()).unwrap();
    unsafe { std::slice::from_raw_parts(val.as_ptr() as *const u8, size) }
}

// ═══════════════════════════════════════════════════════════════════
// Interaction list helpers
// ═══════════════════════════════════════════════════════════════════

fn compact_interaction_lists(lists: &InteractionLists) -> (Vec<u32>, Vec<u32>) {
    let n_nodes = lists.lengths.len();
    let mut offsets = Vec::with_capacity(n_nodes + 1);
    let mut indices = Vec::new();
    offsets.push(0u32);
    for node in 0..n_nodes {
        let len = lists.lengths[node] as usize;
        for &partner in lists.data[node][..len].iter() {
            if partner == u32::MAX {
                break;
            }
            indices.push(partner);
        }
        offsets.push(indices.len() as u32);
    }
    (indices, offsets)
}

fn build_leaf_id(tree: &Tree) -> Vec<u32> {
    let n = tree
        .nodes
        .iter()
        .filter(|n| n.is_leaf)
        .fold(0usize, |max, n| max.max(n.body_end));
    let mut leaf_id = vec![0u32; n];
    for (node_id, node) in tree.nodes.iter().enumerate() {
        if node.is_leaf {
            for i in node.body_start..node.body_end {
                leaf_id[i] = node_id as u32;
            }
        }
    }
    leaf_id
}

fn build_leaf_ranges(tree: &Tree) -> Vec<[u32; 2]> {
    let mut ranges = vec![[0u32, 0u32]; tree.nodes.len()];
    for (node_id, node) in tree.nodes.iter().enumerate() {
        if node.is_leaf {
            ranges[node_id] = [node.body_start as u32, node.body_end as u32];
        }
    }
    ranges
}

// ═══════════════════════════════════════════════════════════════════
// Kernel derivative recurrence
// ═══════════════════════════════════════════════════════════════════

/// Precompute polynomial coefficients N_{k,l}[a][b] for G^{(k,l)}.
///
/// G^{(k,l)} = (Σ N_{k,l}[a][b] · x^a · y^b) / R^{1+2k+2l}
/// where R² = x² + y² + ε².
///
/// Coefficients depend only on ε² and p (not on x, y).
pub fn build_kernel_polys(p: usize, eps: f32) -> Vec<Vec<Vec<f32>>> {
    let order = 2 * p;
    let stride = order + 1;
    let eps2 = eps * eps;
    let idx = |k: usize, l: usize| k * stride + l;

    let mut poly: Vec<Vec<Vec<f32>>> = vec![vec![vec![0.0f32; stride]; stride]; stride * stride];

    // N_{0,0} = -1
    poly[idx(0, 0)][0][0] = -1.0;

    for n in 1..=order {
        for k in 0..=n {
            let l = n - k;
            let mut coeff = vec![vec![0.0f32; stride]; stride];

            if k > 0 {
                let prev = &poly[idx(k - 1, l)];
                let m = (1 + 2 * (k - 1) + 2 * l) as f32;

                // D · ∂N/∂x term
                for a in 0..stride {
                    for b in 0..(stride - a) {
                        let c = prev[a][b];
                        if c == 0.0 {
                            continue;
                        }
                        if a > 0 {
                            let dc = c * a as f32;
                            if a + 1 < stride {
                                coeff[a + 1][b] += dc;
                            }
                            if b + 2 < stride {
                                coeff[a - 1][b + 2] += dc;
                            }
                            coeff[a - 1][b] += dc * eps2;
                        }
                    }
                }
                // -(1+2k+2l)·N·x term
                for a in 0..stride {
                    for b in 0..(stride - a) {
                        let c = prev[a][b];
                        if c == 0.0 {
                            continue;
                        }
                        if a + 1 < stride {
                            coeff[a + 1][b] -= m * c;
                        }
                    }
                }
            } else if l > 0 {
                let prev = &poly[idx(k, l - 1)];
                let m = (1 + 2 * k + 2 * (l - 1)) as f32;

                // D · ∂N/∂y term
                for a in 0..stride {
                    for b in 0..(stride - a) {
                        let c = prev[a][b];
                        if c == 0.0 {
                            continue;
                        }
                        if b > 0 {
                            let dc = c * b as f32;
                            if a + 2 < stride {
                                coeff[a + 2][b - 1] += dc;
                            }
                            if b + 1 < stride {
                                coeff[a][b + 1] += dc;
                            }
                            coeff[a][b - 1] += dc * eps2;
                        }
                    }
                }
                // -(1+2k+2l)·N·y term
                for a in 0..stride {
                    for b in 0..(stride - a) {
                        let c = prev[a][b];
                        if c == 0.0 {
                            continue;
                        }
                        if b + 1 < stride {
                            coeff[a][b + 1] -= m * c;
                        }
                    }
                }
            }

            poly[idx(k, l)] = coeff;
        }
    }

    poly
}

/// Evaluate G^{(k,l)}(dx, dy, ε) using precomputed polynomial coefficients.
pub fn eval_g_deriv(
    polys: &[Vec<Vec<f32>>],
    order: usize,
    stride: usize,
    dx: f32,
    dy: f32,
    eps: f32,
    k: usize,
    l: usize,
) -> f32 {
    let r2 = dx * dx + dy * dy + eps * eps;
    let r = r2.sqrt();
    let max_exp = 1 + 2 * order;
    let mut inv_r = vec![0.0f32; max_exp + 2];
    inv_r[1] = 1.0 / r;
    for n in (3..=max_exp).step_by(2) {
        inv_r[n] = inv_r[n - 2] / r2;
    }

    let idx = |k: usize, l: usize| k * stride + l;
    let mut val = 0.0f32;
    let poly = &polys[idx(k, l)];
    for a in 0..stride {
        for b in 0..(stride - a) {
            let c = poly[a][b];
            if c != 0.0 {
                val += c * dx.powi(a as i32) * dy.powi(b as i32);
            }
        }
    }
    let exp = 1 + 2 * k + 2 * l;
    val * inv_r[exp]
}

/// Moment index: flat index for derivative (k, l) where k+l ≤ p.
fn deriv_idx(k: usize, l: usize) -> usize {
    let n = k + l;
    n * (n + 1) / 2 + l
}

/// Generate a WGSL source module containing the kernel derivative evaluation
/// function with coefficients baked as inline constants.
pub fn generate_deriv_wgsl(p: usize, eps: f32) -> String {
    let order = 2 * p;
    let stride = order + 1;
    let n_derivs = (order + 1) * (order + 2) / 2;
    let polys = build_kernel_polys(p, eps);

    let mut wgsl = String::new();

    wgsl.push_str("struct DerivParams {\n");
    wgsl.push_str("    dx: f32,\n");
    wgsl.push_str("    dy: f32,\n");
    wgsl.push_str("    eps: f32,\n");
    wgsl.push_str("}\n\n");
    wgsl.push_str("@group(0) @binding(0) var<storage, read> params: array<DerivParams>;\n");
    wgsl.push_str("@group(0) @binding(1) var<storage, read_write> results: array<f32>;\n\n");

    wgsl.push_str("struct ErrFlag { value: atomic<u32>, }\n");
    wgsl.push_str("@group(0) @binding(2) var<storage, read_write> error_flag: ErrFlag;\n\n");

wgsl.push_str(&format!(
    "fn eval_kernel_deriv(dx: f32, dy: f32, eps: f32, result: ptr<function, array<f32, {}>>) {{\n",
    n_derivs
));
wgsl.push_str("    let r2 = dx * dx + dy * dy + eps * eps;\n");
wgsl.push_str("    let inv_sqrt_r2 = 1.0 / sqrt(r2);\n");
wgsl.push_str(&format!(
    "    var invR: array<f32, {}>;\n",
    max_exp_to_wgsl_size(1 + 2 * order)
));
wgsl.push_str("    invR[1] = inv_sqrt_r2;\n");
wgsl.push_str(&format!(
    "    for (var n = 3u; n <= {}u; n = n + 2u) {{\n",
    1 + 2 * order
));
wgsl.push_str("        invR[n] = invR[n - 2u] / r2;\n");
wgsl.push_str("    }\n\n");

for k in 0..=order {
    for l in 0..=(order - k) {
        let mi = deriv_idx(k, l);
        let exp = 1 + 2 * k + 2 * l;

        wgsl.push_str(&format!("    // G^({},{})\n", k, l));
        wgsl.push_str("    {\n");
        wgsl.push_str("        var val = 0.0;\n");

        let idx = k * stride + l;
        let poly = &polys[idx];
        for a in 0..stride {
            for b in 0..(stride - a) {
                let c = poly[a][b];
                if c != 0.0 {
                    let mut term = fmt_f32(c);
                    if a > 0 {
                        term.push_str(&format!(" * pow(dx, f32({}))", a));
                    }
                    if b > 0 {
                        term.push_str(&format!(" * pow(dy, f32({}))", b));
                    }
                    wgsl.push_str(&format!("        val += {};\n", term));
                }
            }
        }

        wgsl.push_str(&format!("        (*result)[{}] = val * invR[{}];\n", mi, exp));
        wgsl.push_str("    }\n\n");
    }
}

wgsl.push_str("}\n\n");

    wgsl.push_str("@compute @workgroup_size(64)\n");
    wgsl.push_str("fn main(@builtin(global_invocation_id) id: vec3<u32>) {\n");
    wgsl.push_str("    let i = id.x;\n");
    wgsl.push_str("    let p = params[i];\n");
    wgsl.push_str("    if (p.dx != p.dx || p.dy != p.dy || p.eps != p.eps) {\n");
    wgsl.push_str("        atomicMax(&error_flag.value, 1u);\n");
    wgsl.push_str("        return;\n");
    wgsl.push_str("    }\n");
    wgsl.push_str("    var result: array<f32, ");
    wgsl.push_str(&n_derivs.to_string());
    wgsl.push_str(">;\n");
    wgsl.push_str("    eval_kernel_deriv(p.dx, p.dy, p.eps, &result);\n");
    wgsl.push_str(&format!(
        "    for (var j = 0u; j < {}u; j = j + 1u) {{\n",
        n_derivs
    ));
    wgsl.push_str("        results[i * ");
    wgsl.push_str(&n_derivs.to_string());
    wgsl.push_str(" + j] = result[j];\n");
    wgsl.push_str("    }\n");
    wgsl.push_str("}\n");

    wgsl
}

fn fmt_f32(val: f32) -> String {
    let s = format!("{}", val);
    if s.contains('.') || s.contains('e') || s.contains('E') {
        s
    } else {
        format!("{}.0", s)
    }
}

fn max_exp_to_wgsl_size(max_exp: usize) -> usize {
    max_exp + 2
}

// ═══════════════════════════════════════════════════════════════════
// GpuContext
// ═══════════════════════════════════════════════════════════════════

pub struct GpuContext {
    pub(crate) device: Arc<wgpu::Device>,
    pub(crate) queue: Arc<wgpu::Queue>,
    config: GpuConfig,

    geometry_buffer: wgpu::Buffer,
    mass_buffer: wgpu::Buffer,
    dynamics_buffer: wgpu::Buffer,
    expansion_buffer: wgpu::Buffer,
    interaction_indices: wgpu::Buffer,
    interaction_offsets: wgpu::Buffer,
    leaf_id_buffer: wgpu::Buffer,
    node_centers: wgpu::Buffer,
    node_leaf_ranges: wgpu::Buffer,
    node_children: wgpu::Buffer,
    uniform_buffer: wgpu::Buffer,
    error_flag_buffer: wgpu::Buffer,
    readback_buffer: wgpu::Buffer,

    p2p_bind_group: wgpu::BindGroup,
    p2p_pipeline: wgpu::ComputePipeline,

    geometry_byte_size: u64,
    dynamics_byte_size: u64,
    readback_byte_size: u64,
}

impl GpuContext {
    pub fn new(
        device: Arc<wgpu::Device>,
        queue: Arc<wgpu::Queue>,
        config: GpuConfig,
    ) -> Result<Self, GpuError> {
        let geometry_byte_size = config.max_n as u64 * 8;
        let dynamics_byte_size = config.max_n as u64 * 8;
        let mass_byte_size = config.max_n as u64 * 4;
        let expand_stride = ((config.p as usize + 1) * (config.p as usize + 2) / 2) as u64;
        let expansion_byte_size = config.max_nodes as u64 * expand_stride * 4 * 2;
        let interaction_indices_size = config.max_interactions as u64 * 4;
        let interaction_offsets_size = (config.max_nodes as u64 + 1) * 4;
        let leaf_id_byte_size = config.max_n as u64 * 4;
        let node_centers_byte_size = config.max_nodes as u64 * 8;
        let node_leaf_ranges_size = config.max_nodes as u64 * 8;
        let node_children_size = config.max_nodes as u64 * 16;
        let readback_byte_size = dynamics_byte_size;
        let copy_alignment = 256u64;

        fn create_buf(
            d: &wgpu::Device,
            label: &str,
            size: u64,
            usage: wgpu::BufferUsages,
        ) -> wgpu::Buffer {
            d.create_buffer(&wgpu::BufferDescriptor {
                label: Some(label),
                size,
                usage,
                mapped_at_creation: false,
            })
        }

        let geometry_buffer = create_buf(
            &device,
            "geometry",
            geometry_byte_size,
            wgpu::BufferUsages::STORAGE | wgpu::BufferUsages::COPY_DST,
        );
        let dynamics_buffer = create_buf(
            &device,
            "dynamics",
            dynamics_byte_size,
            wgpu::BufferUsages::STORAGE
                | wgpu::BufferUsages::COPY_SRC
                | wgpu::BufferUsages::COPY_DST,
        );
        let mass_buffer = create_buf(
            &device,
            "mass",
            mass_byte_size,
            wgpu::BufferUsages::STORAGE | wgpu::BufferUsages::COPY_DST,
        );
        let expansion_buffer = create_buf(
            &device,
            "expansions",
            expansion_byte_size,
            wgpu::BufferUsages::STORAGE | wgpu::BufferUsages::COPY_DST,
        );
        let interaction_indices = create_buf(
            &device,
            "interaction_indices",
            interaction_indices_size,
            wgpu::BufferUsages::STORAGE | wgpu::BufferUsages::COPY_DST,
        );
        let interaction_offsets = create_buf(
            &device,
            "interaction_offsets",
            interaction_offsets_size,
            wgpu::BufferUsages::STORAGE | wgpu::BufferUsages::COPY_DST,
        );
        let leaf_id_buffer = create_buf(
            &device,
            "leaf_id",
            leaf_id_byte_size,
            wgpu::BufferUsages::STORAGE | wgpu::BufferUsages::COPY_DST,
        );
        let node_centers = create_buf(
            &device,
            "node_centers",
            node_centers_byte_size,
            wgpu::BufferUsages::STORAGE | wgpu::BufferUsages::COPY_DST,
        );
        let node_leaf_ranges = create_buf(
            &device,
            "node_leaf_ranges",
            node_leaf_ranges_size,
            wgpu::BufferUsages::STORAGE | wgpu::BufferUsages::COPY_DST,
        );
        let node_children = create_buf(
            &device,
            "node_children",
            node_children_size,
            wgpu::BufferUsages::STORAGE | wgpu::BufferUsages::COPY_DST,
        );
        let uniform_buffer = create_buf(
            &device,
            "uniform",
            UNIFORM_PADDED_SIZE,
            wgpu::BufferUsages::UNIFORM | wgpu::BufferUsages::COPY_DST,
        );
        let error_flag_buffer = create_buf(
            &device,
            "error_flag",
            4,
            wgpu::BufferUsages::STORAGE
                | wgpu::BufferUsages::COPY_SRC
                | wgpu::BufferUsages::COPY_DST,
        );
        let readback_buffer = create_buf(
            &device,
            "readback",
            (readback_byte_size + copy_alignment - 1) & !(copy_alignment - 1),
            wgpu::BufferUsages::MAP_READ | wgpu::BufferUsages::COPY_DST,
        );

        queue.write_buffer(&error_flag_buffer, 0, &0u32.to_ne_bytes());

        // ── P2P shader ──────────────────────────────────────
        let p2p_src = include_str!(concat!(env!("OUT_DIR"), "/p2p.wgsl"));
        let p2p_module = device.create_shader_module(wgpu::ShaderModuleDescriptor {
            label: Some("p2p"),
            source: wgpu::ShaderSource::Wgsl(Cow::Borrowed(p2p_src)),
        });

        let p2p_bgl = device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
            label: Some("p2p"),
            entries: &[
                wgpu::BindGroupLayoutEntry {
                    binding: 0,
                    visibility: wgpu::ShaderStages::COMPUTE,
                    ty: wgpu::BindingType::Buffer {
                        ty: wgpu::BufferBindingType::Storage { read_only: true },
                        has_dynamic_offset: false,
                        min_binding_size: None,
                    },
                    count: None,
                },
                wgpu::BindGroupLayoutEntry {
                    binding: 1,
                    visibility: wgpu::ShaderStages::COMPUTE,
                    ty: wgpu::BindingType::Buffer {
                        ty: wgpu::BufferBindingType::Storage { read_only: true },
                        has_dynamic_offset: false,
                        min_binding_size: None,
                    },
                    count: None,
                },
                wgpu::BindGroupLayoutEntry {
                    binding: 2,
                    visibility: wgpu::ShaderStages::COMPUTE,
                    ty: wgpu::BindingType::Buffer {
                        ty: wgpu::BufferBindingType::Storage { read_only: false },
                        has_dynamic_offset: false,
                        min_binding_size: None,
                    },
                    count: None,
                },
                wgpu::BindGroupLayoutEntry {
                    binding: 3,
                    visibility: wgpu::ShaderStages::COMPUTE,
                    ty: wgpu::BindingType::Buffer {
                        ty: wgpu::BufferBindingType::Uniform,
                        has_dynamic_offset: false,
                        min_binding_size: None,
                    },
                    count: None,
                },
                wgpu::BindGroupLayoutEntry {
                    binding: 4,
                    visibility: wgpu::ShaderStages::COMPUTE,
                    ty: wgpu::BindingType::Buffer {
                        ty: wgpu::BufferBindingType::Storage { read_only: false },
                        has_dynamic_offset: false,
                        min_binding_size: None,
                    },
                    count: None,
                },
                wgpu::BindGroupLayoutEntry {
                    binding: 5,
                    visibility: wgpu::ShaderStages::COMPUTE,
                    ty: wgpu::BindingType::Buffer {
                        ty: wgpu::BufferBindingType::Storage { read_only: true },
                        has_dynamic_offset: false,
                        min_binding_size: None,
                    },
                    count: None,
                },
                wgpu::BindGroupLayoutEntry {
                    binding: 6,
                    visibility: wgpu::ShaderStages::COMPUTE,
                    ty: wgpu::BindingType::Buffer {
                        ty: wgpu::BufferBindingType::Storage { read_only: true },
                        has_dynamic_offset: false,
                        min_binding_size: None,
                    },
                    count: None,
                },
                wgpu::BindGroupLayoutEntry {
                    binding: 7,
                    visibility: wgpu::ShaderStages::COMPUTE,
                    ty: wgpu::BindingType::Buffer {
                        ty: wgpu::BufferBindingType::Storage { read_only: true },
                        has_dynamic_offset: false,
                        min_binding_size: None,
                    },
                    count: None,
                },
                wgpu::BindGroupLayoutEntry {
                    binding: 8,
                    visibility: wgpu::ShaderStages::COMPUTE,
                    ty: wgpu::BindingType::Buffer {
                        ty: wgpu::BufferBindingType::Storage { read_only: true },
                        has_dynamic_offset: false,
                        min_binding_size: None,
                    },
                    count: None,
                },
            ],
        });

        let p2p_layout = device.create_pipeline_layout(&wgpu::PipelineLayoutDescriptor {
            label: Some("p2p"),
            bind_group_layouts: &[&p2p_bgl],
            push_constant_ranges: &[],
        });

        let p2p_pipeline = device.create_compute_pipeline(&wgpu::ComputePipelineDescriptor {
            label: Some("p2p"),
            layout: Some(&p2p_layout),
            module: &p2p_module,
            entry_point: "main",
            compilation_options: wgpu::PipelineCompilationOptions::default(),
            cache: None,
        });

        let p2p_bind_group = device.create_bind_group(&wgpu::BindGroupDescriptor {
            label: Some("p2p"),
            layout: &p2p_bgl,
            entries: &[
                wgpu::BindGroupEntry {
                    binding: 0,
                    resource: wgpu::BindingResource::Buffer(wgpu::BufferBinding {
                        buffer: &geometry_buffer,
                        offset: 0,
                        size: None,
                    }),
                },
                wgpu::BindGroupEntry {
                    binding: 1,
                    resource: wgpu::BindingResource::Buffer(wgpu::BufferBinding {
                        buffer: &mass_buffer,
                        offset: 0,
                        size: None,
                    }),
                },
                wgpu::BindGroupEntry {
                    binding: 2,
                    resource: wgpu::BindingResource::Buffer(wgpu::BufferBinding {
                        buffer: &dynamics_buffer,
                        offset: 0,
                        size: None,
                    }),
                },
                wgpu::BindGroupEntry {
                    binding: 3,
                    resource: wgpu::BindingResource::Buffer(wgpu::BufferBinding {
                        buffer: &uniform_buffer,
                        offset: 0,
                        size: None,
                    }),
                },
                wgpu::BindGroupEntry {
                    binding: 4,
                    resource: wgpu::BindingResource::Buffer(wgpu::BufferBinding {
                        buffer: &error_flag_buffer,
                        offset: 0,
                        size: None,
                    }),
                },
                wgpu::BindGroupEntry {
                    binding: 5,
                    resource: wgpu::BindingResource::Buffer(wgpu::BufferBinding {
                        buffer: &interaction_indices,
                        offset: 0,
                        size: None,
                    }),
                },
                wgpu::BindGroupEntry {
                    binding: 6,
                    resource: wgpu::BindingResource::Buffer(wgpu::BufferBinding {
                        buffer: &interaction_offsets,
                        offset: 0,
                        size: None,
                    }),
                },
                wgpu::BindGroupEntry {
                    binding: 7,
                    resource: wgpu::BindingResource::Buffer(wgpu::BufferBinding {
                        buffer: &leaf_id_buffer,
                        offset: 0,
                        size: None,
                    }),
                },
                wgpu::BindGroupEntry {
                    binding: 8,
                    resource: wgpu::BindingResource::Buffer(wgpu::BufferBinding {
                        buffer: &node_leaf_ranges,
                        offset: 0,
                        size: None,
                    }),
                },
            ],
        });

        Ok(Self {
            device,
            queue,
            config,
            geometry_buffer,
            mass_buffer,
            dynamics_buffer,
            expansion_buffer,
            interaction_indices,
            interaction_offsets,
            leaf_id_buffer,
            node_centers,
            node_leaf_ranges,
            node_children,
            uniform_buffer,
            error_flag_buffer,
            readback_buffer,
            p2p_bind_group,
            p2p_pipeline,
            geometry_byte_size,
            dynamics_byte_size,
            readback_byte_size,
        })
    }

    pub fn upload_tree_data(
        &self,
        tree: &Tree,
        _m2l_lists: &InteractionLists,
        p2p_lists: &InteractionLists,
    ) {
        let (indices, offsets) = compact_interaction_lists(p2p_lists);
        self.queue
            .write_buffer(&self.interaction_indices, 0, bytes_of_slice(&indices));
        self.queue
            .write_buffer(&self.interaction_offsets, 0, bytes_of_slice(&offsets));

        let leaf_id = build_leaf_id(tree);
        self.queue
            .write_buffer(&self.leaf_id_buffer, 0, bytes_of_slice(&leaf_id));

        let leaf_ranges = build_leaf_ranges(tree);
        self.queue
            .write_buffer(&self.node_leaf_ranges, 0, bytes_of_slice(&leaf_ranges));
    }

    pub fn step(&self, bodies: &BodiesSoA) {
        let n = bodies.len() as u32;

        let params = SimParamsRaw {
            n,
            num_nodes: self.config.max_nodes,
            num_leaves: self.config.max_nodes,
            p: self.config.p,
            eps: self.config.eps,
            _pad: 0.0,
        };
        self.queue
            .write_buffer(&self.uniform_buffer, 0, bytes_of(&params));

        {
            let mut flat: Vec<f32> = Vec::with_capacity(bodies.len() * 2);
            for i in 0..bodies.len() {
                flat.push(bodies.x[i] as f32);
                flat.push(bodies.y[i] as f32);
            }
            self.queue
                .write_buffer(&self.geometry_buffer, 0, bytes_of_slice(&flat));
        }

        {
            let mut flat: Vec<f32> = Vec::with_capacity(bodies.len());
            for i in 0..bodies.len() {
                flat.push(bodies.mass[i] as f32);
            }
            self.queue
                .write_buffer(&self.mass_buffer, 0, bytes_of_slice(&flat));
        }

        {
            let zeroes: Vec<f32> = vec![0.0f32; bodies.len() * 2];
            self.queue
                .write_buffer(&self.dynamics_buffer, 0, bytes_of_slice(&zeroes));
        }

        self.queue
            .write_buffer(&self.error_flag_buffer, 0, &0u32.to_ne_bytes());

        let mut encoder = self
            .device
            .create_command_encoder(&wgpu::CommandEncoderDescriptor {
                label: Some("step"),
            });

        {
            let mut cpass = encoder.begin_compute_pass(&wgpu::ComputePassDescriptor {
                label: Some("p2p"),
                timestamp_writes: None,
            });
            cpass.set_pipeline(&self.p2p_pipeline);
            cpass.set_bind_group(0, &self.p2p_bind_group, &[]);
            let wg_count = (n + 63) / 64;
            cpass.dispatch_workgroups(wg_count, 1, 1);
        }

        self.queue.submit(std::iter::once(encoder.finish()));
        self.check_error_flag();
    }

    fn check_error_flag(&self) {
        let mut encoder = self
            .device
            .create_command_encoder(&wgpu::CommandEncoderDescriptor {
                label: Some("error_check"),
            });
        encoder.copy_buffer_to_buffer(&self.error_flag_buffer, 0, &self.readback_buffer, 0, 4);
        self.queue.submit(std::iter::once(encoder.finish()));

        let (tx, rx) = std::sync::mpsc::channel();
        let slice = self.readback_buffer.slice(..4);
        slice.map_async(wgpu::MapMode::Read, move |r| {
            let _ = tx.send(r);
        });
        let _ = self.device.poll(wgpu::Maintain::Wait);
        match rx.recv() {
            Ok(Ok(())) => {}
            _ => panic!("GPU error flag readback failed"),
        }
        let data = slice.get_mapped_range();
        let flag = u32::from_ne_bytes([data[0], data[1], data[2], data[3]]);
        drop(data);
        self.readback_buffer.unmap();
        if flag != 0 {
            panic!("GPU NaN error detected");
        }
    }

    pub fn read_accelerations(&self, ax: &mut [f64], ay: &mut [f64]) {
        let n = ax.len().min(ay.len());
        let mut encoder = self
            .device
            .create_command_encoder(&wgpu::CommandEncoderDescriptor {
                label: Some("readback"),
            });
        encoder.copy_buffer_to_buffer(
            &self.dynamics_buffer,
            0,
            &self.readback_buffer,
            0,
            n as u64 * 8,
        );
        self.queue.submit(std::iter::once(encoder.finish()));

        let (tx, rx) = std::sync::mpsc::channel();
        let slice = self.readback_buffer.slice(..(n as u64 * 8));
        slice.map_async(wgpu::MapMode::Read, move |r| {
            let _ = tx.send(r);
        });
        let _ = self.device.poll(wgpu::Maintain::Wait);
        match rx.recv() {
            Ok(Ok(())) => {}
            _ => panic!("GPU readback mapping failed"),
        }
        let data = slice.get_mapped_range();
        for i in 0..n {
            let offset = i * 8;
            let x = f32::from_ne_bytes([
                data[offset],
                data[offset + 1],
                data[offset + 2],
                data[offset + 3],
            ]);
            let y = f32::from_ne_bytes([
                data[offset + 4],
                data[offset + 5],
                data[offset + 6],
                data[offset + 7],
            ]);
            ax[i] = x as f64;
            ay[i] = y as f64;
        }
        drop(data);
        self.readback_buffer.unmap();
    }

    pub fn device(&self) -> &wgpu::Device {
        &self.device
    }
    pub fn queue(&self) -> &wgpu::Queue {
        &self.queue
    }
}

// ═══════════════════════════════════════════════════════════════════
// Tests
// ═══════════════════════════════════════════════════════════════════

#[cfg(test)]
mod tests {
    use super::*;
    use galax_core::{build_p2p_lists, InteractionLists, Tree as CoreTree};

    fn create_gpu_context(max_n: u32) -> GpuContext {
        let instance = wgpu::Instance::new(wgpu::InstanceDescriptor::default());
        let adapter = pollster::block_on(instance.request_adapter(&wgpu::RequestAdapterOptions {
            power_preference: wgpu::PowerPreference::LowPower,
            compatible_surface: None,
            force_fallback_adapter: false,
        }))
        .expect("no GPU adapter available for test");
        let (device, queue) = pollster::block_on(adapter.request_device(
            &wgpu::DeviceDescriptor {
                label: Some("galax-gpu-test"),
                required_features: wgpu::Features::empty(),
                required_limits: wgpu::Limits::default(),
                ..Default::default()
            },
            None,
        ))
        .expect("failed to create GPU device for test");

        let config = GpuConfig {
            max_n,
            max_nodes: max_n.max(1024),
            max_interactions: (max_n * 64).max(4096),
            p: 4,
            eps: 0.1,
        };
        GpuContext::new(Arc::new(device), Arc::new(queue), config)
            .expect("failed to init GPU context for test")
    }

    // ── Interaction list tests (Issue 02) ──────────────────────

    #[test]
    fn test_interaction_list_compaction() {
        let n_nodes = 5;
        let mut data = vec![[u32::MAX; 64]; n_nodes];
        let mut lengths = vec![0u8; n_nodes];
        data[0][..3].copy_from_slice(&[1, 2, 3]);
        lengths[0] = 3;
        data[1][..2].copy_from_slice(&[0, 4]);
        lengths[1] = 2;
        data[2][..0].copy_from_slice(&[]);
        lengths[2] = 0;
        data[3][..1].copy_from_slice(&[0]);
        lengths[3] = 1;
        data[4][..1].copy_from_slice(&[1]);
        lengths[4] = 1;
        let lists = InteractionLists { data, lengths };

        let (indices, offsets) = compact_interaction_lists(&lists);
        assert_eq!(offsets.len(), 6);
        assert_eq!(&indices[0..3], &[1, 2, 3]);
        assert_eq!(&indices[3..5], &[0, 4]);
        assert_eq!(&indices[5..6], &[0]);
        assert_eq!(&indices[6..7], &[1]);
    }

    #[test]
    fn test_build_leaf_id_and_ranges() {
        let mut bodies = BodiesSoA::new(200);
        for i in 0..200 {
            bodies.x[i] = fastrand::f64() * 100.0 - 50.0;
            bodies.y[i] = fastrand::f64() * 100.0 - 50.0;
            bodies.mass[i] = 1.0;
        }
        let tree = CoreTree::build(&mut bodies, 32, -50.0, 50.0, -50.0, 50.0);
        let leaf_id = build_leaf_id(&tree);
        let leaf_ranges = build_leaf_ranges(&tree);
        for i in 0..200 {
            let lid = leaf_id[i] as usize;
            assert!(tree.nodes[lid].is_leaf, "body {} maps to non-leaf", i);
            let range = leaf_ranges[lid];
            assert!(i >= range[0] as usize && i < range[1] as usize);
        }
    }

    #[test]
    fn test_gpu_p2p_vs_cpu_p2p() {
        let n = 200u32;
        let ctx = create_gpu_context(n * 2);
        let mut bodies = BodiesSoA::new(n as usize);
        for i in 0..n as usize {
            bodies.x[i] = fastrand::f64() * 100.0 - 50.0;
            bodies.y[i] = fastrand::f64() * 100.0 - 50.0;
            bodies.mass[i] = fastrand::f64() * 10.0 + 0.1;
        }
        let tree = CoreTree::build(&mut bodies, 32, -50.0, 50.0, -50.0, 50.0);
        let p2p_lists = build_p2p_lists(&tree);
        let m2l_lists = InteractionLists::build(&tree);

        let mut cpu_bodies = BodiesSoA::new(n as usize);
        cpu_bodies.x.copy_from_slice(&bodies.x);
        cpu_bodies.y.copy_from_slice(&bodies.y);
        cpu_bodies.mass.copy_from_slice(&bodies.mass);
        galax_core::p2p(&mut cpu_bodies, &tree, &p2p_lists, 0.1);

        ctx.upload_tree_data(&tree, &m2l_lists, &p2p_lists);
        ctx.step(&bodies);
        ctx.read_accelerations(&mut bodies.ax, &mut bodies.ay);

        let mut max_rel_err = 0.0f64;
        for i in 0..n as usize {
            let cpu_ax = cpu_bodies.ax[i];
            let cpu_ay = cpu_bodies.ay[i];
            let gpu_ax = bodies.ax[i];
            let gpu_ay = bodies.ay[i];
            let cpu_mag = (cpu_ax * cpu_ax + cpu_ay * cpu_ay).sqrt();
            let gpu_mag = (gpu_ax * gpu_ax + gpu_ay * gpu_ay).sqrt();
            let denom = cpu_mag.max(gpu_mag).max(1e-30);
            let err = ((gpu_ax - cpu_ax).powi(2) + (gpu_ay - cpu_ay).powi(2)).sqrt() / denom;
            max_rel_err = max_rel_err.max(err);
        }
        assert!(max_rel_err < 1e-4, "GPU P2P error {:.2e}", max_rel_err);
    }

    // ── Kernel derivative tests (Issue 03) ─────────────────────

    /// Reference: evaluate G^{(k,l)} using the Rust polynomial builder.
    fn reference_deriv(dx: f32, dy: f32, eps: f32, p: usize, k: usize, l: usize) -> f32 {
        let polys = build_kernel_polys(p, eps);
        let order = 2 * p;
        let stride = order + 1;
        eval_g_deriv(&polys, order, stride, dx, dy, eps, k, l)
    }

    #[test]
    fn test_build_kernel_polys_symmetry() {
        let p = 4;
        let eps = 0.1;
        let order = 2 * p;
        let polys = build_kernel_polys(p, eps);

        // For k = l, N_{k,k}[a][b] should equal N_{k,k}[b][a] because
        // the polynomial for ∂^{2k}G/∂x^k∂y^k is symmetric in x and y.
        let idx = |k: usize, l: usize| k * (order + 1) + l;
        let stride = order + 1;
        let mut max_rel = 0.0f32;
        for k in 0..=order {
            let pk = &polys[idx(k, k)];
            for a in 0..stride {
                for b in 0..(stride - a) {
                    let c_ab = pk[a][b];
                    let c_ba = pk[b][a];
                    if c_ab.abs() > 1e-6 || c_ba.abs() > 1e-6 {
                        let diff = (c_ab - c_ba).abs();
                        let max_val = c_ab.abs().max(c_ba.abs()).max(1e-30);
                        let rel = diff / max_val;
                        max_rel = max_rel.max(rel);
                        assert!(
                            rel < 5e-4,
                            "N_({},{})=[{},{}]: {} vs {}, rel {}",
                            k, k, a, b, c_ab, c_ba, rel
                        );
                    }
                }
            }
        }
        eprintln!("Max relative coefficient asymmetry: {:.2e}", max_rel);
    }

    #[test]
    fn test_deriv_analytic_values() {
        let dx = 1.0f32;
        let dy = 2.0f32;
        let eps = 0.5f32;
        let r2 = dx * dx + dy * dy + eps * eps;

        // G^{(0,0)} = -1/sqrt(D)
        let g00 = reference_deriv(dx, dy, eps, 4, 0, 0);
        assert!((g00 - (-1.0 / r2.sqrt())).abs() < 1e-5, "G^(0,0)");

        // G^{(1,0)} = x / D^{3/2}
        let g10 = reference_deriv(dx, dy, eps, 4, 1, 0);
        let r3 = r2 * r2.sqrt();
        assert!((g10 - dx / r3).abs() < 1e-5, "G^(1,0)");

        // G^{(0,1)} = y / D^{3/2}
        let g01 = reference_deriv(dx, dy, eps, 4, 0, 1);
        assert!((g01 - dy / r3).abs() < 1e-5, "G^(0,1)");

        // G^{(1,1)} = -3xy / D^{5/2}
        let g11 = reference_deriv(dx, dy, eps, 4, 1, 1);
        let r5 = r2 * r2 * r2.sqrt();
        assert!((g11 - (-3.0 * dx * dy / r5)).abs() < 1e-5, "G^(1,1)");
    }

    /// Test WGSL kernel derivative evaluation against Rust reference.
    #[test]
    fn test_deriv_wgsl_vs_rust() {
        // Compile and dispatch a WGSL shader that evaluates kernel derivatives
        let instance = wgpu::Instance::new(wgpu::InstanceDescriptor::default());
        let adapter = pollster::block_on(instance.request_adapter(&wgpu::RequestAdapterOptions {
            power_preference: wgpu::PowerPreference::LowPower,
            compatible_surface: None,
            force_fallback_adapter: false,
        }))
        .expect("no GPU adapter");
        let (device, queue) = pollster::block_on(adapter.request_device(
            &wgpu::DeviceDescriptor {
                label: Some("test-deriv"),
                required_features: wgpu::Features::empty(),
                required_limits: wgpu::Limits::default(),
                ..Default::default()
            },
            None,
        ))
        .expect("failed to create GPU device");

        let p = 4;
        let eps = 0.1f32;
        let order = 2 * p;
        let n_derivs = (order + 1) * (order + 2) / 2;
        let n_test_points = 50u32;

        // Generate WGSL shader with baked coefficients
        let wgsl_src = generate_deriv_wgsl(p, eps);
        let module = device.create_shader_module(wgpu::ShaderModuleDescriptor {
            label: Some("deriv_test"),
            source: wgpu::ShaderSource::Wgsl(Cow::Borrowed(&wgsl_src)),
        });

        // Bind group layout: params (storage, read), results (storage, read_write), error_flag (storage)
        let bgl = device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
            label: Some("deriv_test"),
            entries: &[
                wgpu::BindGroupLayoutEntry {
                    binding: 0,
                    visibility: wgpu::ShaderStages::COMPUTE,
                    ty: wgpu::BindingType::Buffer {
                        ty: wgpu::BufferBindingType::Storage { read_only: true },
                        has_dynamic_offset: false,
                        min_binding_size: None,
                    },
                    count: None,
                },
                wgpu::BindGroupLayoutEntry {
                    binding: 1,
                    visibility: wgpu::ShaderStages::COMPUTE,
                    ty: wgpu::BindingType::Buffer {
                        ty: wgpu::BufferBindingType::Storage { read_only: false },
                        has_dynamic_offset: false,
                        min_binding_size: None,
                    },
                    count: None,
                },
                wgpu::BindGroupLayoutEntry {
                    binding: 2,
                    visibility: wgpu::ShaderStages::COMPUTE,
                    ty: wgpu::BindingType::Buffer {
                        ty: wgpu::BufferBindingType::Storage { read_only: false },
                        has_dynamic_offset: false,
                        min_binding_size: None,
                    },
                    count: None,
                },
            ],
        });

        let pl = device.create_pipeline_layout(&wgpu::PipelineLayoutDescriptor {
            label: Some("deriv_test"),
            bind_group_layouts: &[&bgl],
            push_constant_ranges: &[],
        });

        let pipeline = device.create_compute_pipeline(&wgpu::ComputePipelineDescriptor {
            label: Some("deriv_test"),
            layout: Some(&pl),
            module: &module,
            entry_point: "main",
            compilation_options: wgpu::PipelineCompilationOptions::default(),
            cache: None,
        });

        // Create test input points
        let params_size = (n_test_points as u64 * mem::size_of::<[f32; 3]>() as u64);
        let results_size = (n_test_points as u64 * n_derivs as u64 * mem::size_of::<f32>() as u64);
        let error_size = 4u64;

        let params_buf = device.create_buffer(&wgpu::BufferDescriptor {
            label: Some("params"),
            size: params_size,
            usage: wgpu::BufferUsages::STORAGE | wgpu::BufferUsages::COPY_DST,
            mapped_at_creation: false,
        });
        let results_buf = device.create_buffer(&wgpu::BufferDescriptor {
            label: Some("results"),
            size: results_size,
            usage: wgpu::BufferUsages::STORAGE | wgpu::BufferUsages::COPY_SRC,
            mapped_at_creation: false,
        });
        let error_buf = device.create_buffer(&wgpu::BufferDescriptor {
            label: Some("error"),
            size: error_size,
            usage: wgpu::BufferUsages::STORAGE
                | wgpu::BufferUsages::COPY_SRC
                | wgpu::BufferUsages::COPY_DST,
            mapped_at_creation: false,
        });
        let readback_buf = device.create_buffer(&wgpu::BufferDescriptor {
            label: Some("readback"),
            size: results_size.max(error_size),
            usage: wgpu::BufferUsages::MAP_READ | wgpu::BufferUsages::COPY_DST,
            mapped_at_creation: false,
        });

        // Generate deterministic test points
        fastrand::seed(42);
        let stride = order + 1;
        let mut param_data = Vec::with_capacity(n_test_points as usize * 3);
        let mut rust_results = Vec::with_capacity(n_test_points as usize * n_derivs);
        for ti in 0..n_test_points {
            let dx = fastrand::f32() * 10.0 - 5.0;
            let dy = fastrand::f32() * 10.0 - 5.0;
            param_data.push(dx);
            param_data.push(dy);
            param_data.push(eps);

            // Compute Rust reference into deriv_idx-mapped array
            let polys = build_kernel_polys(p, eps);
            let mut rvals = vec![0.0f32; n_derivs];
            for k in 0..=order {
                for l in 0..=(order - k) {
                    let mi = deriv_idx(k, l);
                    rvals[mi] = eval_g_deriv(&polys, order, stride, dx, dy, eps, k, l);
                }
            }

            // Debug first point
            if ti == 0 {
                let r2 = dx*dx + dy*dy + eps*eps;
                let inv_r3 = 1.0 / (r2 * r2.sqrt());
                let deriv_10 = rvals[deriv_idx(1, 0)];
                let deriv_01 = rvals[deriv_idx(0, 1)];
                eprintln!("Point 0: dx={:.4}, dy={:.4}, eps={}", dx, dy, eps);
                eprintln!("  G^(1,0) = {:.6}, dx/r^3 = {:.6}", deriv_10, dx * inv_r3);
                eprintln!("  G^(0,1) = {:.6}, dy/r^3 = {:.6}", deriv_01, dy * inv_r3);
            }

            rust_results.extend(rvals);
        }
        queue.write_buffer(&params_buf, 0, bytes_of_slice(&param_data));
        queue.write_buffer(&error_buf, 0, &0u32.to_ne_bytes());

        let bind_group = device.create_bind_group(&wgpu::BindGroupDescriptor {
            label: Some("deriv_test"),
            layout: &bgl,
            entries: &[
                wgpu::BindGroupEntry {
                    binding: 0,
                    resource: wgpu::BindingResource::Buffer(wgpu::BufferBinding {
                        buffer: &params_buf,
                        offset: 0,
                        size: None,
                    }),
                },
                wgpu::BindGroupEntry {
                    binding: 1,
                    resource: wgpu::BindingResource::Buffer(wgpu::BufferBinding {
                        buffer: &results_buf,
                        offset: 0,
                        size: None,
                    }),
                },
                wgpu::BindGroupEntry {
                    binding: 2,
                    resource: wgpu::BindingResource::Buffer(wgpu::BufferBinding {
                        buffer: &error_buf,
                        offset: 0,
                        size: None,
                    }),
                },
            ],
        });

        let mut encoder = device.create_command_encoder(&wgpu::CommandEncoderDescriptor {
            label: Some("deriv_dispatch"),
        });
        {
            let mut cpass = encoder.begin_compute_pass(&wgpu::ComputePassDescriptor {
                label: Some("deriv"),
                timestamp_writes: None,
            });
            cpass.set_pipeline(&pipeline);
            cpass.set_bind_group(0, &bind_group, &[]);
            let wg_count = (n_test_points + 63) / 64;
            cpass.dispatch_workgroups(wg_count, 1, 1);
        }
        // Copy results to readback
        encoder.copy_buffer_to_buffer(&results_buf, 0, &readback_buf, 0, results_size);
        queue.submit(std::iter::once(encoder.finish()));

        // Readback and compare
        let (tx, rx) = std::sync::mpsc::channel();
        let read_slice = readback_buf.slice(..results_size);
        read_slice.map_async(wgpu::MapMode::Read, move |r| {
            let _ = tx.send(r);
        });
        let _ = device.poll(wgpu::Maintain::Wait);
        rx.recv().unwrap().unwrap();

        let data = read_slice.get_mapped_range();
        let gpu_results: &[f32] = bytemuck::cast_slice(&data);
        let flat_size = n_derivs;

        let mut max_rel_diff = 0.0f32;
        for ti in 0..n_test_points as usize {
            // Re-check epsilon matches the baked value
            let test_eps = param_data[ti * 3 + 2];
            assert!((test_eps - eps).abs() < 1e-6, "eps mismatch at point {}", ti);
            for di in 0..flat_size {
                let gpu_val = gpu_results[ti * flat_size + di];
                let rust_val = rust_results[ti * flat_size + di];
                let max_abs = gpu_val.abs().max(rust_val.abs()).max(1e-30);
                let rel_diff = (gpu_val - rust_val).abs() / max_abs;
                max_rel_diff = max_rel_diff.max(rel_diff);
                assert!(
                    rel_diff < 1e-3,
                    "point {} deriv {}: GPU {} vs Rust {}, rel_diff {}",
                    ti,
                    di,
                    gpu_val,
                    rust_val,
                    rel_diff
                );
            }
        }
        eprintln!("Max relative diff WGSL vs Rust: {:.2e}", max_rel_diff);

        drop(data);
        readback_buf.unmap();
    }
}
